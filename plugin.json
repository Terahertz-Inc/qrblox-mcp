  "author": {
    "name": "Terahertz, Inc.",
    "email": "support@qrblox.com",
    "url": "https://qrblox.com"
  },
  "homepage": "https://qrblox.com",
  "repository": "https://github.com/Terahertz-Inc/qrblox-mcp",
  "license": "MIT",
  "keywords": [
    "qrblox",
    "qr-code",
    "menus",
    "merchants",
    "mcp"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "qrblox": {
          "trust": "untrusted"
        }
      }
    }
